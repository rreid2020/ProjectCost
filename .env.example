# Copy this file to .env.local and fill in your values. Never commit .env.local.

# ---- Database ----
# Local: leave as-is to use the embedded PGlite database in ./data/pglite (no Postgres install needed).
# Production (Vercel): your Neon *pooled* connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL="./data/pglite"

# ---- Clerk (auth + organizations) ----
# Leave blank in local dev to use Clerk's keyless mode (a temporary dev instance is created for you).
# In the Clerk dashboard: enable Organizations, and turn OFF personal accounts so every user belongs to a company.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
CLERK_WEBHOOK_SIGNING_SECRET=""   # webhook endpoint: /api/clerk/webhook (organization.updated, organization.deleted)

# ---- Stripe (subscriptions) ----
STRIPE_SECRET_KEY=""              # sk_test_... for testing
STRIPE_WEBHOOK_SECRET=""          # whsec_... ; endpoint: /api/stripe/webhook (see src/app/api/stripe/webhook/route.ts)
STRIPE_PRICE_STARTER=""           # price_... recurring price for the Starter plan
STRIPE_PRICE_PRO=""               # price_... recurring price for the Pro plan
APP_URL=""                        # optional; e.g. https://app.projectcost.com (used for Stripe redirect URLs)

# ---- Intuit / QuickBooks Online (milestone 2) ----
# developer.intuit.com -> your app -> Keys & credentials. Leave blank until milestone 2.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/callback"
