# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Local database (SQLite file). For production use a Postgres URL.
DATABASE_URL="file:./data/projectcost.db"

# Intuit Developer app keys (developer.intuit.com → your app → Keys & credentials)
# Used from milestone 2 (QuickBooks connection). Leave blank for demo mode.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/callback"
